<ContentPage 
    x:Class="MonkeyFinder.Views.MonkeysPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Monkeys">

    <ScrollView>

        <CollectionView
            ItemsSource="{Binding Monkeys}"
            SelectionMode="Single"
            SelectionChanged="CollectionView_SelectionChanged"
            Margin="10">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <!-- Card container -->
                    <Frame
                        Padding="10"
                        Margin="0,0,0,12"
                        HasShadow="True"
                        CornerRadius="12"
                        BackgroundColor="White">

                        <HorizontalStackLayout Spacing="12">

                            <!-- Rounded image wrapper -->
                            <Frame
                                Padding="0"
                                HasShadow="False"
                                CornerRadius="10"
                                WidthRequest="80"
                                HeightRequest="80">

                                <Image
                                    Source="{Binding Image}"
                                    Aspect="AspectFill" />
                            </Frame>

                            <!-- Text content -->
                            <VerticalStackLayout>

                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="18" />

                                <Label Text="{Binding Location}"
                                       FontSize="14"
                                       TextColor="Gray" />

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </ScrollView>

</ContentPage>
