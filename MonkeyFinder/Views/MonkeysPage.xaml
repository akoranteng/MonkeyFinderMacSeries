<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MonkeyFinder.Views.MonkeysPage"
    Title="Monkeys"
    Padding="0,20,0,0">

    <CollectionView
        ItemsSource="{Binding Monkeys}"
        Margin="10"
        SelectionMode="Single"
        SelectionChanged="CollectionView_SelectionChanged"
        VerticalScrollBarVisibility="Always">

        <CollectionView.ItemTemplate>
            <DataTemplate>

                <Frame
                    Margin="0,10"
                    Padding="0"
                    CornerRadius="12"
                    HasShadow="True"
                    BorderColor="#dddddd"
                    InputTransparent="True">

                    <Grid
                        RowDefinitions="250, Auto, Auto"
                        Padding="10"
                        InputTransparent="True">

                        <!-- Monkey Image -->
                        <Image
                            Grid.Row="0"
                            Source="{Binding Image}"
                            Aspect="AspectFill"
                            HeightRequest="250"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />

                        <!-- Monkey Name -->
                        <Label
                            Grid.Row="1"
                            Text="{Binding Name}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#222"
                            Margin="0,10,0,0" />

                        <!-- Monkey Location -->
                        <Label
                            Grid.Row="2"
                            Text="{Binding Location}"
                            FontSize="14"
                            TextColor="#666"
                            Margin="0,4,0,0" />

                    </Grid>

                </Frame>

            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
